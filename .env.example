# ---------------------------------------------------------------------------
# Valtaris Portal environment. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# Local dev uses SQLite — zero setup, no Docker, no Postgres.
DATABASE_URL="file:./dev.db"
# For a PostgreSQL deployment instead, switch the datasource provider to
# "postgresql" in prisma/schema.prisma and use a URL like:
#   postgresql://valtaris:valtaris@localhost:5432/valtaris?schema=public

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-generate-a-real-secret"
# NEXTAUTH_URL is intentionally omitted — trustHost is enabled, so Auth.js
# derives the URL from the request host and works on any dev port.

# Shared secret the Label Studio webhook must send in X-Valtaris-Webhook-Secret.
LABEL_STUDIO_WEBHOOK_SECRET="dev-label-studio-webhook-secret"

# Base URL of the self-hosted Label Studio Community Edition instance (dev).
LABEL_STUDIO_BASE_URL="http://localhost:8080"
# API token for reconciliation polling (create in Label Studio account settings).
LABEL_STUDIO_API_TOKEN=""

# Cron/job runner shared secret (protects POST /api/jobs/run).
JOB_RUNNER_SECRET="dev-job-runner-secret"

# Shared secret for Studio SSO tokens (must match the Valtaris-Studio fork).
STUDIO_SSO_SECRET="dev-studio-sso-shared-secret-change-me"
